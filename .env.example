# Server-only secrets. Read by the backend (docker compose passes them to backend/api and
# backend/chatbot) — never bundled into the app. Do NOT prefix these with EXPO_PUBLIC_.

# Optional ingredient mapping: absolute host path, used only with compose.ingredients.yaml.
# Never substitute unreviewed candidate records for verified evidence.
INGREDIENT_MAPPING_SOURCE=

# API only: JSON array of verified subscriber member IDs, pending subscription integration.
# A separate list temporarily records IDs whose AR activity consent was verified.
AR_ACTIVITY_ENROLLED_MEMBERS=[]
AR_ACTIVITY_CONSENTED_MEMBERS=[]
SKIN_RECOMMENDATION_FEEDBACK_CONSENTED_MEMBERS=[]

# YouTube Data API v3 (Google Cloud Console) — enables tutorial search
YOUTUBE_API_KEY=
GEMINI_API_KEY=

# Naver Search API (developers.naver.com) — enables real product images & online prices
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Toss Payments test keys — enables checkout. PAYMENT_WEB_BASE_URL must be a public HTTPS address.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_WEB_BASE_URL=

# Supabase secret key (sb_secret_...) — enables account deletion in backend/api only.
SUPABASE_SECRET_KEY=

# Chatbot LLM. Leave empty to keep chat disabled.
LLM_API_KEY=
LLM_MODEL=

# G1 stays ON. G5 is enabled in BOTH services only after its DB and data are verified.
G1_SUPERVISOR_ENABLED=true
G5_ENABLED=false
# API uses this for query embeddings; chatbot uses it for Terra. Server-only.
G5_OPENAI_API_KEY=
# Set the same random server-only token on API and chatbot.
G5_INTERNAL_TOKEN=
# Keep the existing image for existing volumes. For a NEW isolated G5 stack use:
# POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg17-bookworm
POSTGRES_IMAGE=postgres:17-alpine

# Public values, bundled into the app on purpose (Supabase dashboard > Project Settings > API Keys).
# Only the Project URL and the publishable key go here. Never put the secret / service_role key in this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend address for the app (public). Usually the shared dev server on Render, e.g.
# https://vishue-api-xxxx.onrender.com. Leave empty to use a local backend (docker compose) at
# http://<this PC>:8080. Builds use the production address, e.g. https://api.<domain>.
EXPO_PUBLIC_API_BASE_URL=

# Optional public chatbot server address; leave empty when the backend gateway serves /api/chat.
# This is a server URL only, not an LLM API key.
EXPO_PUBLIC_CHAT_API_BASE_URL=

# Development-only NIA proxy. Use the SAME random 32+ character secret in the Python shell.
NIA_EVAL_TOKEN=
NIA_EVAL_PORT=8765

# On-device skin analysis (model assets must be prepared before starting Expo).
EXPO_PUBLIC_ENABLE_SKIN_ANALYSIS=1
SKIN_ANALYSIS_MODEL=skin-analysis-v4

# Server-side recommendation model (the cat-v4 bundle ships with the API).
# Place model.cbm and manifest.json in ml/runs/<RECOMMENDATION_MODEL>/bundle/.
RECOMMENDATION_MODEL=recommend-cat-v4
# Optional model root for a mounted server directory. Default: <repository>/ml/runs.
# RECOMMENDATION_MODELS_DIR=/models
