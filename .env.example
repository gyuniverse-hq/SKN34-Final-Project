# Server-only secrets. Read by the backend (docker compose passes them to backend/api and
# backend/chatbot) — never bundled into the app. Do NOT prefix these with EXPO_PUBLIC_.

# YouTube Data API v3 (Google Cloud Console) — enables tutorial search
YOUTUBE_API_KEY=

# Naver Search API (developers.naver.com) — enables real product images & online prices
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Toss Payments test keys — enables checkout. PAYMENT_WEB_BASE_URL must be a public HTTPS address.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_WEB_BASE_URL=

# Supabase secret key (sb_secret_...) — enables account deletion in backend/api only.
SUPABASE_SECRET_KEY=

# Chatbot LLM. Leave empty to keep chat disabled.
LLM_API_KEY=
LLM_MODEL=

# Public values, bundled into the app on purpose (Supabase dashboard > Project Settings > API Keys).
# Only the Project URL and the publishable key go here. Never put the secret / service_role key in this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend address for the app (public). Usually the shared dev server on Render, e.g.
# https://vishue-api-xxxx.onrender.com. Leave empty to use a local backend (docker compose) at
# http://<this PC>:8080. Builds use the production address, e.g. https://api.<domain>.
EXPO_PUBLIC_API_BASE_URL=

# Development-only NIA proxy. Use the SAME random 32+ character secret in the Python shell.
NIA_EVAL_TOKEN=
NIA_EVAL_PORT=8765

# On-device skin analysis (model assets must be prepared before starting Expo).
EXPO_PUBLIC_ENABLE_SKIN_ANALYSIS=1
