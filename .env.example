# Server-only secrets. Read by API routes (app/api/**) — never bundled into the app.
# Do NOT prefix these with EXPO_PUBLIC_.

# YouTube Data API v3 (Google Cloud Console) — enables tutorial search
YOUTUBE_API_KEY=

# Naver Search API (developers.naver.com) — enables real product images & online prices
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
