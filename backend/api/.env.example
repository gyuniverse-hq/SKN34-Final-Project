# Local run without Docker: copy to backend/api/.env (never commit .env).
ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://vishue:vishue@localhost:15432/vishue
REDIS_URL=redis://localhost:16379/0
# Public Supabase values (same as the app's EXPO_PUBLIC_SUPABASE_*), used to verify access tokens.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# JSON list, only needed when a browser calls the API from another origin.
CORS_ORIGINS=[]

# Toss Payments test keys. Keep the secret server-only; `PAYMENT_WEB_BASE_URL` must be public HTTPS.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_WEB_BASE_URL=

# MFDS cosmetic ingredient collection script (load with uv run --env-file .env).
MFDS_SERVICE_KEY=
