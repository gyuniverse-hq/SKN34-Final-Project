# Local run without Docker: copy to backend/api/.env (never commit .env).
ENV=local
# Verified subscriber IDs and separately verified AR activity consent IDs.
AR_ACTIVITY_ENROLLED_MEMBERS=[]
AR_ACTIVITY_CONSENTED_MEMBERS=[]
# Empty disables the cart recommendation experiment.
CART_RECOMMENDATION_EXPERIMENT=
# Member IDs with confirmed consent to skin recommendation feedback collection.
SKIN_RECOMMENDATION_FEEDBACK_CONSENTED_MEMBERS=[]
# Server-side CatBoost selection. Default bundle: <repository>/ml/runs/<name>/bundle/.
RECOMMENDATION_MODEL=recommend-cat-v4
# Optional model root for mounted bundles (for example /models).
# RECOMMENDATION_MODELS_DIR=/models
# Optional absolute path to the server's mapping JSON. Unset keeps ingredient lookup unavailable.
INGREDIENT_MAPPING_PATH=
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://vishue:vishue@localhost:15432/vishue_db
REDIS_URL=redis://localhost:16379/0
# Public Supabase values (same as the app's EXPO_PUBLIC_SUPABASE_*), used to verify access tokens.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key (sb_secret_...), used only to delete accounts. Leave empty to
# disable account deletion.
SUPABASE_SECRET_KEY=
# JSON list, only needed when a browser calls the API from another origin.
CORS_ORIGINS=[]

# Toss Payments test keys. Keep the secret server-only; `PAYMENT_WEB_BASE_URL` must be public HTTPS.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_WEB_BASE_URL=

# MFDS cosmetic ingredient collection script (load with uv run --env-file .env).
MFDS_SERVICE_KEY=

# Admin web API + lip triad naturalness (OpenAI-compatible vision). Prefer Astra id in LLM_MODEL.
ADMIN_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
ASTRA_MODEL=
LLM_TIMEOUT_SECONDS=60
# Temporary bare/real/ar files for lip product-panel eval (eval period only).
# ADMIN_LIP_EVAL_DIR=
# Admin Ops chatbot probe (k8s: http://vishue-chatbot:8000).
# CHATBOT_BASE_URL=
# Browser admin/web origins, JSON array. Include admin and consumer web hosts.
# CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:5174"]
