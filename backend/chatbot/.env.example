# Local run without Docker: copy to backend/chatbot/.env (never commit .env).
ENV=local
LOG_LEVEL=INFO
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vishue-local
REDIS_URL=redis://localhost:6379/1
CATALOG_API_URL=http://localhost:8000
# Any OpenAI-compatible endpoint. Leave key or model empty to keep the chatbot disabled (503).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
CHAT_REQUESTS_PER_MINUTE=10
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=[]
