# Server machine only. Copy to .env.skin-server.local (gitignored).
# Use supabase for configured app users, or test-token for a temporary trusted-client test.
SKIN_AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only for test-token mode; use a random value of at least 32 characters.
SKIN_TEST_BEARER_TOKEN=
# Optional overrides. Empty values use the existing ML config and repository paths.
SKIN_GPU_UUID=
SKIN_MODEL_BUNDLE=
SKIN_FACE_MODEL=
SKIN_MAX_UPLOAD_BYTES=12582912
