{
  "version": "lip-rubric-v2",
  "title": "립 자연스러움 채점표",
  "questions": [
    {
      "id": "q1",
      "title": "결",
      "hint": "입술 확대 사진을 보세요",
      "checks": [
        {
          "id": "q1_1",
          "text": "입술의 세로 주름이 보이나요?",
          "na_allowed": false
        },
        {
          "id": "q1_2",
          "text": "색을 입힌 뒤에도 주름이 뭉개지지 않고 또렷하게 남아 있나요?",
          "na_allowed": false
        },
        {
          "id": "q1_3",
          "text": "입술이 페인트나 플라스틱이 아니라 진짜 피부처럼 보이나요?",
          "na_allowed": false
        },
        {
          "id": "q1_4",
          "text": "입술만 유난히 깨끗하거나 매끈하지 않고, 주변 피부와 사진 느낌(거칠기, 흐림)이 비슷한가요?",
          "na_allowed": false
        },
        {
          "id": "q1_5",
          "text": "입술 안에 얼룩이나 끊긴 곳 없이 고르게 보이나요?",
          "na_allowed": false
        }
      ]
    },
    {
      "id": "q2",
      "title": "명암",
      "hint": "입술 확대 사진을 보세요",
      "checks": [
        {
          "id": "q2_1",
          "text": "윗입술과 아랫입술의 명암이 얼굴 조명과 입술 형태에 어울리나요?",
          "na_allowed": false
        },
        {
          "id": "q2_2",
          "text": "아랫입술의 밝고 어두운 부분이 얼굴 조명과 입술 형태에 맞아 볼록해 보이나요?",
          "na_allowed": false
        },
        {
          "id": "q2_3",
          "text": "입꼬리 주변의 명암이 얼굴 조명과 입술 형태에 자연스럽게 어울리나요?",
          "na_allowed": false
        },
        {
          "id": "q2_4",
          "text": "입술이 한 가지 밝기로 납작하게 칠해지지 않고 입체감이 있나요?",
          "na_allowed": false
        },
        {
          "id": "q2_5",
          "text": "얼굴에서 밝은 쪽과 입술에서 밝은 쪽이 같은 방향인가요? (예: 얼굴 왼쪽이 밝으면 입술도 왼쪽이 밝음)",
          "na_allowed": false
        }
      ]
    },
    {
      "id": "q3",
      "title": "윤기",
      "hint": "화면에 표시된 제형을 확인하세요",
      "checks": [
        {
          "id": "q3_1",
          "text": "반짝이는 정도가 제형과 맞나요? (매트는 거의 없음, 새틴은 은은함, 글로시는 뚜렷함)",
          "na_allowed": false
        },
        {
          "id": "q3_2",
          "text": "반짝이는 곳이 아랫입술 가운데나 윗입술 산처럼 볼록한 곳에 있나요?",
          "na_allowed": {
            "finish": [
              "matte"
            ]
          }
        },
        {
          "id": "q3_3",
          "text": "반짝이는 위치가 얼굴의 밝은 쪽과 어울리나요?",
          "na_allowed": {
            "finish": [
              "matte"
            ]
          }
        },
        {
          "id": "q3_4",
          "text": "반짝임이 흰 물감 한 점이 아니라 입술 결을 따라 퍼져 보이나요?",
          "na_allowed": {
            "finish": [
              "matte"
            ]
          }
        },
        {
          "id": "q3_5",
          "text": "반짝임 때문에 입술 색이 하얗게 날아간 곳이 없나요?",
          "na_allowed": false
        }
      ]
    },
    {
      "id": "q4",
      "title": "경계",
      "hint": "입술 테두리를 보세요",
      "checks": [
        {
          "id": "q4_1",
          "text": "입술 테두리가 가위로 오린 것처럼 딱딱하지 않고 자연스럽나요?",
          "na_allowed": false
        },
        {
          "id": "q4_2",
          "text": "테두리의 선명한 정도가 사진의 다른 윤곽(눈, 코)과 비슷한가요?",
          "na_allowed": false
        },
        {
          "id": "q4_3",
          "text": "테두리를 따라 색이 끊기거나 들쭉날쭉한 곳 없이 매끄럽게 이어지나요?",
          "na_allowed": false
        },
        {
          "id": "q4_4",
          "text": "입꼬리에서 색이 부드럽게 사라지나요? (뾰족하게 튀어나오거나 뭉툭하게 잘리지 않음)",
          "na_allowed": false
        },
        {
          "id": "q4_5",
          "text": "윗입술과 아랫입술이 만나는 안쪽 선이 자연스럽게 이어지나요?",
          "na_allowed": false
        }
      ]
    },
    {
      "id": "q5",
      "title": "밀착감",
      "hint": "전체 사진과 확대 사진을 둘 다 보세요",
      "checks": [
        {
          "id": "q5_1",
          "text": "색이 입술 위에 붙인 필름처럼 떠 있지 않고, 입술에 스며든 것처럼 보이나요?",
          "na_allowed": false
        },
        {
          "id": "q5_2",
          "text": "전체 사진(폰 크기)으로 볼 때 어색한 곳이 없나요?",
          "na_allowed": false
        },
        {
          "id": "q5_3",
          "text": "확대 사진으로 볼 때도 어색한 곳이 없나요?",
          "na_allowed": false
        },
        {
          "id": "q5_4",
          "text": "입술 색의 분위기가 얼굴 조명(따뜻한 빛, 차가운 빛)과 어울리나요?",
          "na_allowed": false
        },
        {
          "id": "q5_5",
          "text": "처음 보는 사람에게 보여 주면 실제로 립을 바른 사진이라고 믿을 것 같나요?",
          "na_allowed": false
        }
      ]
    }
  ],
  "overall": {
    "question": "전체적으로 입술이 얼마나 자연스러워 보이나요?",
    "scale": {
      "1": "색을 그냥 칠한 것 같다",
      "2": "대부분 어색하다",
      "3": "바로 티가 나지만 바른 느낌은 있다",
      "4": "자세히 보면 살짝 티가 난다",
      "5": "진짜 바른 사진 같다"
    }
  }
